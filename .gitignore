# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Prebuilt WSL kernels (distribute via GitHub Releases, not git)
vendor/wsl-kernel/**
!vendor/wsl-kernel/.gitkeep
*.bzImage

# GApps zips contain Google proprietary bits — keep local only
vendor/gapps/**
!vendor/gapps/.gitkeep
!vendor/gapps/README.md
!vendor/gapps/manifest.json

# Magisk assets (fork APK + LSPosed/Shamiko module zips) — downloaded locally.
# The overlay *source* in vendor/magisk-overlay/ is committed; this only hides downloads.
vendor/magisk/**
!vendor/magisk/.gitkeep
!vendor/magisk/README.md

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
