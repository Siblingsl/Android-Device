# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.worktrees/
.playwright-cli/
.workbuddy/
target-codex-*/
dist
dist-ssr
*.local

# Environment files may contain API identifiers, credentials, or local paths.
.env
.env.*
!.env.example

# Prebuilt WSL kernels (distribute via GitHub Releases, not git)
vendor/wsl-kernel/**
!vendor/wsl-kernel/.gitkeep
*.bzImage

# Generated runtime seed and private matrix APK; keep large local artifacts out of GitHub.
work/runtime-core-protection-20260917/matrix-assets/xhs-base.apk
work/runtime-core-protection-20260917/temp-node2-partial-20260918/node2/seed.img

# GApps zips contain Google proprietary bits — keep local only
vendor/gapps/**
!vendor/gapps/.gitkeep
!vendor/gapps/README.md
!vendor/gapps/manifest.json

# Magisk assets (fork APK + LSPosed/Shamiko module zips) — downloaded locally.
# The overlay *source* in vendor/magisk-overlay/ is committed; this only hides downloads.
vendor/magisk/**
!vendor/magisk/.gitkeep
!vendor/magisk/README.md

# Keep the downloaded Gnirehtet archive out of source control; the extracted
# runtime files are the assets bundled by Tauri.
vendor/gnirehtet/**/*.zip

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python bytecode from running the scripts above (e.g. the guest-side
# unittest in src-tauri/src/services/test_qemu_guest.py) - never committed.
__pycache__/
*.py[cod]
