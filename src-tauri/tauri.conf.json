{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Just Run",
  "version": "0.1.0",
  "identifier": "com.redroid.device-center",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Just Run",
        "width": 1100,
        "height": 720,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "additionalBrowserArgs": "--force-renderer-accessibility"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../vendor/gnirehtet/windows-x64/gnirehtet.exe": "gnirehtet/windows-x64/gnirehtet.exe",
      "../vendor/gnirehtet/windows-x64/gnirehtet.apk": "gnirehtet/windows-x64/gnirehtet.apk",
      "../vendor/gnirehtet/windows-x64/gnirehtet-run.cmd": "gnirehtet/windows-x64/gnirehtet-run.cmd",
      "../vendor/gnirehtet/windows-x64/LICENSE": "gnirehtet/windows-x64/LICENSE",
      "../vendor/gnirehtet/windows-x64/README.md": "gnirehtet/windows-x64/README.md"
    }
  }
}
